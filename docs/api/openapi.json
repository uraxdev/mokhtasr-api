	},
	"components": {
		"schemas": {
			"Auth Initiate Payload": {
				"type": "object",
				"properties": {
					"phone": {
						"type": "string",
						"pattern": "^\\+20(10|11|12|15)\\d{8}$"
					}
				},
				"required": ["phone"]
			},
			"Auth Initiate Response": {
				"type": "object",
				"properties": {
					"verificationId": {
						"type": "string",
						"format": "uuid"
					}
				},
				"required": ["verificationId"]
			},
			"Auth Verify Payload": {
				"type": "object",
				"properties": {
					"verificationId": {
						"type": "string",
						"format": "uuid"
					},
					"phone": {
						"type": "string",
						"pattern": "^\\+20(10|11|12|15)\\d{8}$"
					},
					"otp": {
						"type": "string",
						"minLength": 6,
						"maxLength": 6
					},
					"role": {
						"type": "string",
						"enum": ["ADMIN", "HANDYMAN", "CUSTOMER"],
						"description": "Required only when verifying for a brand-new user; ignored for existing users"
					}
				},
				"required": ["phone", "verificationId", "otp"]
			},
			"Auth Verify Response": {
				"type": "object",
				"properties": {
					"access": {
						"type": "string"
					},
					"refresh": {
						"type": "string"
					},
					"user": {
						"$ref": "#/components/schemas/User"
					}
				},
				"required": ["access", "refresh", "user"]
			},
			"User": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string",
						"format": "uuid"
					},
					"name": {
						"type": "string"
					},
					"phone": {
						"type": "string",
						"pattern": "^\\+20(10|11|12|15)\\d{8}$"
					},
					"role": {
						"type": "string",
						"enum": ["ADMIN", "HANDYMAN", "CUSTOMER"]
					},
					"avatar": {
						"type": "string",
						"format": "uri",
						"nullable": true
					},
					"createdAt": {
						"type": "string",
						"format": "date-time"
					},
					"updatedAt": {
						"type": "string",
						"format": "date-time"
					},
					"admin": {
						"$ref": "#/components/schemas/Admin",
						"nullable": true
					},
					"customer": {
						"$ref": "#/components/schemas/Customer",
						"nullable": true
					},
					"handyman": {
						"$ref": "#/components/schemas/Handyman",
						"nullable": true
					}
				},
				"required": ["id", "name", "phone", "role", "createdAt", "updatedAt"]
			},
			"Handyman": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string",
						"format": "uuid"
					},
					"workDays": {
						"type": "array",
						"items": {
							"type": "string",
							"enum": ["SUNDAY", "MONDAY", "TUESDAY", "WEDNESDAY", "THURSDAY", "FRIDAY", "SATURDAY"]
						}
					},
					"status": {
						"type": "string",
						"default": "PENDING",
						"enum": ["PENDING", "REJECTED", "BLOCKED", "ACCEPTED"]
					},
					"birthdate": {
						"type": "string",
						"format": "date-time",
						"nullable": true
					},
					"userId": {
						"type": "string",
						"format": "uuid"
					},
					"user": {
						"$ref": "#/components/schemas/User",
						"description": "Present whenever the handyman is fetched through HandymanService (list/find/update/delete/block)"
					},
					"createdAt": {
						"type": "string",
						"format": "date-time"
					},
					"updatedAt": {
						"type": "string",
						"format": "date-time"
					}
				},
				"required": ["id", "workDays", "status", "birthdate", "userId", "createdAt", "updatedAt"]
			},
			"Handyman Update Payload": {
				"type": "object",
				"description": "At least one field must be provided.",
				"properties": {
					"regions": {
						"type": "array",
						"items": {
							"type": "string",
							"format": "uuid"
						}
					},
					"workDays": {
						"type": "array",
						"items": {
							"type": "string",
							"enum": ["SUNDAY", "MONDAY", "TUESDAY", "WEDNESDAY", "THURSDAY", "FRIDAY", "SATURDAY"]
						},
						"description": "An empty array resets to the default (all seven days)"
					}
				}
			},
			"Admin": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string",
						"format": "uuid"
					},
					"userId": {
						"type": "string",
						"format": "uuid"
					},
					"createdAt": {
						"type": "string",
						"format": "date-time"
					},
					"updatedAt": {
						"type": "string",
						"format": "date-time"
					}
				},
				"required": ["id", "userId", "createdAt", "updatedAt"]
			},
			"Customer": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string",
						"format": "uuid"
					},
					"userId": {
						"type": "string",
						"format": "uuid"
					},
					"createdAt": {
						"type": "string",
						"format": "date-time"
					},
					"updatedAt": {
						"type": "string",
						"format": "date-time"
					}
				},
				"required": ["id", "userId", "createdAt", "updatedAt"]
			},
			"Application": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string",
						"format": "uuid"
					},
					"firstName": {
						"type": "string"
					},
					"lastName": {
						"type": "string"
					},
					"nationalIdFront": {
						"type": "string",
						"format": "uri"
					},
					"nationalIdBack": {
						"type": "string",
						"format": "uri"
					},
					"selfie": {
						"type": "string",
						"format": "uri"
					},
					"birthdate": {
						"type": "string",
						"format": "date-time"
					},
					"handymanId": {
						"type": "string",
						"format": "uuid"
					},
					"status": {
						"type": "string",
						"default": "PENDING",
						"enum": ["PENDING", "REJECTED", "EXPIRED", "ACCEPTED"]
					},
					"expiresAt": {
						"type": "string",
						"format": "date-time"
					},
					"notes": {
						"type": "string",
						"nullable": true
					},
					"createdAt": {
						"type": "string",
						"format": "date-time"
					},
					"updatedAt": {
						"type": "string",
						"format": "date-time"
					},
					"regions": {
						"type": "array",
						"items": {
							"type": "object",
							"properties": {
								"id": {
									"type": "string",
									"format": "uuid"
								},
								"name": {
									"type": "string"
								}
							},
							"required": ["id", "name"]
						}
					},
					"services": {
						"type": "array",
						"items": {
							"type": "object",
							"properties": {
								"id": {
									"type": "string",
									"format": "uuid"
								},
								"name": {
									"type": "object",
									"properties": {
										"ar": {
											"type": "string"
										},
										"en": {
											"type": "string"
										}
									},
									"required": ["ar", "en"]
								}
							},
							"required": ["id", "name"]
						}
					}
				},
				"required": ["id", "firstName", "lastName", "nationalIdFront", "nationalIdBack", "selfie", "birthdate", "handymanId", "status", "expiresAt", "createdAt", "updatedAt", "regions", "services"]
			},
			"Application Reject Payload": {
				"type": "object",
				"properties": {
					"notes": {
						"type": "string"
					}
				},
				"required": ["notes"]
			},
			"Region": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string",
						"format": "uuid"
					},
					"name": {
						"type": "string"
					},
					"parentRegionId": {
						"type": "string",
						"format": "uuid",
						"nullable": true
					},
					"createdAt": {
						"type": "string",
						"format": "date-time"
					},
					"updatedAt": {
						"type": "string",
						"format": "date-time"
					}
				},
				"required": ["id", "name", "parentRegionId", "createdAt", "updatedAt"]
			},
			"Category": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string",
						"format": "uuid"
					},
					"name": {
						"type": "object",
						"properties": {
							"ar": {
								"type": "string"
							},
							"en": {
								"type": "string"
							}
						},
						"required": ["ar", "en"]
					},
					"createdAt": {
						"type": "string",
						"format": "date-time"
					},
					"updatedAt": {
						"type": "string",
						"format": "date-time"
					},
					"services": {
						"type": "array",
						"description": "Only present on Find (GET /categories/{id})",
						"items": {
							"$ref": "#/components/schemas/Service"
						}
					}
				},
				"required": ["id", "name", "createdAt", "updatedAt"]
			},
			"Service": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string",
						"format": "uuid"
					},
					"name": {
						"type": "object",
						"properties": {
							"ar": {
								"type": "string"
							},
							"en": {
								"type": "string"
							}
						},
						"required": ["ar", "en"]
					},
					"categoryId": {
						"type": "string",
						"format": "uuid"
					},
					"createdAt": {
						"type": "string",
						"format": "date-time"
					},
					"updatedAt": {
						"type": "string",
						"format": "date-time"
					}
				},
				"required": ["id", "name", "categoryId", "createdAt", "updatedAt"]
			},
			"Proposal": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string",
						"format": "uuid"
					},
					"title": {
						"type": "string"
					},
					"description": {
						"type": "string"
					},
					"address": {
						"type": "string"
					},
					"status": {
						"type": "string",
						"default": "WAITING_OFFERS",
						"enum": ["WAITING_OFFERS", "OFFERS_RECEIVED", "ACCEPTED", "IN_PROGRESS", "AWAITING_COMPLETION", "INSPECTION_COMPLETED", "COMPLETED", "CANCELLED", "EXPIRED"]
					},
					"dueDate": {
						"type": "string",
						"format": "date-time"
					},
					"latitude": {
						"type": "number",
						"nullable": true
					},
					"longitude": {
						"type": "number",
						"nullable": true
					},
					"serviceId": {
						"type": "string",
						"format": "uuid"
					},
					"customerId": {
						"type": "string",
						"format": "uuid"
					},
					"createdAt": {
						"type": "string",
						"format": "date-time"
					},
					"updatedAt": {
						"type": "string",
						"format": "date-time"
					},
					"service": {
						"$ref": "#/components/schemas/Service"
					},
					"visits": {
						"type": "array",
						"items": {
							"$ref": "#/components/schemas/Visit"
						}
					}
				},
				"required": ["id", "title", "description", "address", "status", "dueDate", "serviceId", "customerId", "createdAt", "updatedAt", "service", "visits"]
			},
			"Proposal Create Payload": {
				"type": "object",
				"properties": {
					"title": {
						"type": "string"
					},
					"description": {
						"type": "string"
					},
					"address": {
						"type": "string"
					},
					"dueDate": {
						"type": "string",
						"format": "date-time",
						"description": "Deadline for the work. Must be in the future."
					},
					"latitude": {
						"type": "number",
						"nullable": true
					},
					"longitude": {
						"type": "number",
						"nullable": true
					},
					"serviceId": {
						"type": "string",
						"format": "uuid"
					}
				},
				"required": ["title", "description", "address", "dueDate", "serviceId"]
			},
			"Proposal Extend Payload": {
				"type": "object",
				"properties": {
					"dueDate": {
						"type": "string",
						"format": "date-time",
						"description": "New deadline for the work. Must be in the future."
					}
				},
				"required": ["dueDate"]
			},
			"Accept Visit Payload": {
				"type": "object",
				"properties": {
					"visitId": {
						"type": "string",
						"format": "uuid"
					}
				},
				"required": ["visitId"]
			},
			"Visit": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string",
						"format": "uuid"
					},
					"type": {
						"type": "string",
						"enum": ["INSPECTION", "WORK"]
					},
					"price": {
						"type": "number",
						"nullable": true,
						"description": "Required for WORK visits"
					},
					"currency": {
						"type": "string",
						"default": "EGP"
					},
					"status": {
						"type": "string",
						"default": "PENDING",
						"enum": ["PENDING", "ACCEPTED", "DECLINED", "COMPLETED"]
					},
					"completionCode": {
						"type": "string",
						"nullable": true,
						"description": "Only included in the response once the visit's stage is AT_LOCATION or AWAITING_CODE"
					},
					"message": {
						"type": "string",
						"nullable": true
					},
					"estimatedDuration": {
						"type": "string",
						"nullable": true
					},
					"scheduledFor": {
						"type": "string",
						"format": "date-time",
						"nullable": true,
						"description": "Not allowed for INSPECTION visits"
					},
					"stage": {
						"type": "string",
						"enum": ["INITIATED", "AT_LOCATION", "AWAITING_CODE"],
						"nullable": true
					},
					"proposalId": {
						"type": "string",
						"format": "uuid"
					},
					"handymanId": {
						"type": "string",
						"format": "uuid"
					},
					"convertedFromVisitId": {
						"type": "string",
						"format": "uuid",
						"nullable": true
					},
					"createdAt": {
						"type": "string",
						"format": "date-time"
					},
					"updatedAt": {
						"type": "string",
						"format": "date-time"
