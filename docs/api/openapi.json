{
	"openapi": "3.0.1",
	"info": {
		"title": "Mokhtasr",
		"description": "",
		"version": "1.0.0"
	},
	"tags": [
		{
			"name": "Admins",
			"description": "Internal administrative operations"
		},
		{
			"name": "Applications",
			"description": "Handyman KYC/onboarding applications — review, accept, reject."
		},
		{
			"name": "Auth",
			"description": "Phone/OTP authentication — initiate, verify, refresh."
		},
		{
			"name": "Categories",
			"description": "Top-level service categories."
		},
		{
			"name": "Chat",
			"description": "In-visit chat messages and reschedule proposals."
		},
		{
			"name": "Financials",
			"description": "Handyman earnings summary and transaction history."
		},
		{
			"name": "Handymen",
			"description": "Handyman profile updates and admin moderation (block)."
		},
		{
			"name": "Jobs",
			"description": "Handyman-facing feed of open proposals to bid on."
		},
		{
			"name": "Notifications",
			"description": "In-app notification inbox and push device token registration."
		},
		{
			"name": "Proposals",
			"description": "Customer job proposals and their lifecycle."
		},
		{
			"name": "Realtime",
			"description": "Live delivery over WebSocket — connection handshake, message envelope, and event types (notification:created, chat:message)."
		},
		{
			"name": "Regions",
			"description": "Service regions."
		},
		{
			"name": "Register",
			"description": "Completes registration for a given role after auth."
		},
		{
			"name": "Reviews",
			"description": "Customer reviews of completed visits."
		},
		{
			"name": "Services",
			"description": "Services offered within a category."
		},
		{
			"name": "Users",
			"description": "The authenticated user's own profile."
		},
		{
			"name": "Visits",
			"description": "Handyman inspection/work visits and their lifecycle."
		}
	],
