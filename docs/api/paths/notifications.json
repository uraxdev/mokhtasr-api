{
	"Notifications List": {
		"get": {
			"summary": "List",
			"deprecated": false,
			"description": "Lists the authenticated user's notifications, newest first.",
			"tags": ["Notifications"],
			"parameters": [
				{
					"name": "cursor",
					"in": "query",
					"description": "Notification id to page from, exclusive.",
					"required": false,
					"schema": { "type": "string", "format": "uuid" }
				}
			],
			"responses": {
				"200": {
					"description": "",
					"content": {
						"application/json": {
							"schema": { "type": "array", "items": { "$ref": "../openapi.json#/components/schemas/Notification" } }
						}
					},
					"headers": {}
				}
			},
			"security": [{ "bearer": [] }]
		}
	},
	"Notifications Mark Read": {
		"patch": {
			"summary": "Mark Read",
			"deprecated": false,
			"description": "Marks a single notification belonging to the authenticated user as read.",
			"tags": ["Notifications"],
			"parameters": [
				{
					"name": "id",
					"in": "path",
					"description": "",
					"required": true,
					"schema": { "type": "string", "format": "uuid" }
				}
			],
			"responses": {
				"200": {
					"description": "",
					"content": { "application/json": { "schema": { "$ref": "../openapi.json#/components/schemas/Notification" } } },
					"headers": {}
				},
				"403": { "$ref": "../openapi.json#/components/responses/Error Response", "description": "" },
				"404": { "$ref": "../openapi.json#/components/responses/Error Response", "description": "" }
			},
			"security": [{ "bearer": [] }]
		}
	},
	"Notifications Mark All Read": {
		"patch": {
			"summary": "Mark All Read",
			"deprecated": false,
			"description": "Marks all of the authenticated user's unread notifications as read.",
			"tags": ["Notifications"],
			"parameters": [],
			"responses": {
				"200": {
					"description": "",
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"properties": { "success": { "type": "boolean" } },
								"required": ["success"]
							}
						}
					},
					"headers": {}
				}
			},
			"security": [{ "bearer": [] }]
		}
	},
	"Notifications Register Device": {
		"post": {
			"summary": "Register Device",
			"deprecated": false,
			"description": "Upserts a push device token for the authenticated user, keyed by token. Call on login/app-start.",
			"tags": ["Notifications"],
			"parameters": [],
			"requestBody": {
				"content": {
					"application/json": {
						"schema": { "$ref": "../openapi.json#/components/schemas/Device Token Register Payload" },
						"examples": {}
					}
				},
				"required": true
			},
			"responses": {
				"201": {
					"description": "",
					"content": { "application/json": { "schema": { "$ref": "../openapi.json#/components/schemas/Device Token" } } },
					"headers": {}
				},
				"400": { "$ref": "../openapi.json#/components/responses/Error Response", "description": "" }
			},
			"security": [{ "bearer": [] }]
		}
	},
	"Notifications Unregister Device": {
		"delete": {
			"summary": "Unregister Device",
			"deprecated": false,
			"description": "Deletes a push device token by its value. Call on logout.",
			"tags": ["Notifications"],
			"parameters": [
				{
					"name": "token",
					"in": "path",
					"description": "",
					"required": true,
					"schema": { "type": "string" }
				}
			],
			"responses": {
				"200": {
					"description": "",
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"properties": { "success": { "type": "boolean" } },
								"required": ["success"]
							}
						}
					},
					"headers": {}
				}
			},
			"security": [{ "bearer": [] }]
		}
	}
}
