{
	"name": "mokhtasr-api",
	"version": "1.0.0",
	"type": "module",
	"private": true,
	"license": "UNLICENSED",
	"main": "dist/index.js",
	"module": "src/index.js",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "prisma generate && tsc -p tsconfig.json && tsc-alias -p tsconfig.json --resolve-full-paths --resolve-full-extension .js --verbose",
		"start": "node dist/index.js",
		"compile": "tsc --noEmit",
		"lint": "eslint src/",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate dev --skip-generate",
		"db:seed": "prisma db seed"
	},
	"dependencies": {
		"@prisma/adapter-pg": "^7.7.0",
		"@prisma/client": "^7.7.0",
		"bcryptjs": "^3.0.2",
		"cors": "^2.8.5",
		"dotenv": "^17.2.2",
		"express": "^5.1.0",
		"jsonwebtoken": "^9.0.2",
		"multer": "^2.0.2",
		"request-ip": "^3.3.0",
		"twilio": "^5.10.3",
		"zod": "^4.1.13"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.1",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.3",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/multer": "^2.0.0",
		"@types/node": "^22.18.6",
		"@types/request-ip": "^0.0.41",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.1",
		"globals": "^16.5.0",
		"prisma": "^7.7.0",
		"ts-node": "^10.9.2",
		"tsc-alias": "^1.8.16",
		"tsconfig-paths": "^4.2.0",
		"tsx": "^4.21.0",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.50.0"
	}
}
