<%- include('partials/header', { title: 'Log in', authenticated: false }) %>

<div class="max-w-sm mx-auto bg-white rounded-lg shadow p-8">
	<h1 class="text-xl font-semibold mb-6">Admin log in</h1>

	<% if (error) { %>
	<p class="mb-4 text-sm text-red-600"><%= error %></p>
	<% } %>

	<form method="POST" action="/admins/portal/login" class="space-y-4">
		<div>
			<label for="phone" class="block text-sm font-medium mb-1">Phone number</label>
			<input type="tel" id="phone" name="phone" placeholder="+201012345678" required class="w-full rounded border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-slate-500" />
		</div>
		<button type="submit" class="w-full rounded bg-slate-900 text-white py-2 text-sm font-medium hover:bg-slate-800">Send code</button>
	</form>
</div>

<%- include('partials/footer') %>
